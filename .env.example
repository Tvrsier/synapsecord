# ==========================================================
# SynapseCORD
# Local development environment
# ==========================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------

SYNAPSECORD_ENV=development
SYNAPSECORD_LOG_LEVEL=INFO

# ----------------------------------------------------------
# Discord
# ----------------------------------------------------------

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ----------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synapsecord
POSTGRES_USER=synapsecord
POSTGRES_PASSWORD=change_me

# Full SQLAlchemy connection URL.
# Keep this explicit so Docker/KatanaLab deployments can
# override it without rebuilding the application.
DATABASE_URL=postgresql+psycopg://synapsecord:change_me@localhost:5432/synapsecord

# ----------------------------------------------------------
# Profiler
# ----------------------------------------------------------

PROFILER_POLL_INTERVAL_SECONDS=5

# ----------------------------------------------------------
# Riot Games
# ----------------------------------------------------------

# Not used during M0, but reserved now so configuration
# doesn't need to change structurally during M1.
RIOT_API_KEY=